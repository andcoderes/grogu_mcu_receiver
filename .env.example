# ESP-NOW encryption keys + BLE UUIDs for the Grogu droid.
#
# PMK_KEY / LMK_KEY secure the ESP-NOW link to the future event-trigger
# board (mesh is set up in firmware already, see EspNowController — nothing
# is sent over it yet). Both keys must end up byte-for-byte identical on
# that board's own firmware once it exists.
#
# Copy this file to .env and fill in real values. .env is gitignored —
# never commit it.

PMK_KEY=00000000000000000000000000000000
LMK_KEY=00000000000000000000000000000000

# The real MAC address of the future event-trigger board. Leave as zeros
# until that board exists; once it does, run it, open its Serial monitor,
# and look for: "MAC Address: XX:XX:XX:XX:XX:XX"
EVENT_BOARD_MAC=000000000000

# BLE service/characteristic UUIDs the DroidController app connects to.
#
# SERVICE_UUID is shared across every droid registered in the app (verified
# against Chopper's and roger_roger's own secrets — same value in both), so
# it's pre-filled below; only change it if the app's shared value ever
# changes.
#
# CHARACTERISTIC_UUID must be unique to grogu (every droid has its own).
# A freshly generated one is pre-filled below — regenerate with
# `python3 -c "import uuid; print(uuid.uuid4())"` if it ever collides with
# another droid's entry in the app.
SERVICE_UUID=96e3f2cd-28cf-4d37-9b39-a291f917620e
CHARACTERISTIC_UUID=47a1c0fb-c469-4d6e-a28a-e96c6551dcf6
